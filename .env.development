# Loaded by `npm run dev` and `npm run build:dev`. Committed — no secrets here.
# To override a value for your machine only, put it in `.env.development.local`
# (gitignored). `.env.local` will NOT work — this file outranks it. See .env.example.

VITE_APP_ENV=development

# Full backend origin, INCLUDING the /api/v1 prefix. This is what the deployed
# build (Vercel runs `build:dev`, which loads this file) calls DIRECTLY — there is
# no dev proxy in a static build, so a bare path like /api/v1 would 404. For a
# plain local backend, override this in .env.development.local (gitignored), which
# outranks this file — e.g. VITE_API_BASE_URL=/api/v1 + VITE_DEV_PROXY_TARGET=...
VITE_API_BASE_URL=https://enjoyable-pamperer-uneaten.ngrok-free.dev/api/v1

# Dev-only. When VITE_API_BASE_URL is a same-origin PATH (e.g. /api/v1), the Vite
# dev server proxies that prefix to this backend ORIGIN and injects ngrok's
# skip-browser-warning header (see vite.config.ts). Keeps the browser same-origin
# (no CORS) and bypasses ngrok's interstitial. Empty = the browser calls
# VITE_API_BASE_URL directly (correct for a plain http://localhost backend).
VITE_DEV_PROXY_TARGET=

# Off by default so the app runs against a backend that has not implemented the
# decryption side yet. Flip to true — and fill in the key below — to test the
# real envelope path locally.
VITE_ENCRYPTION_ENABLED=false

VITE_RSA_PUBLIC_KEY=

# ── ML assistant service ─────────────────────────────────────────────────────
# The copilot's real backend. A same-origin PATH here (not a full URL) makes the
# browser talk to the Vite dev server, which proxies "/ml-api" to the ngrok
# origin below and injects ngrok's skip-browser-warning header — dodging both
# CORS and the interstitial. Leave blank to have the app hit the ngrok host
# directly (subject to CORS). See vite.config.ts.
VITE_ML_API_BASE_URL=/ml-api
VITE_ML_DEV_PROXY_TARGET=https://octagon-overpass-smuggling.ngrok-free.dev

# Loaded by `npm run build` and `npm run dev:prod`. Committed — no secrets here.
# Everything in this file ships inside the public JS bundle.
# Per-machine override goes in `.env.production.local` (gitignored), not `.env.local`.

VITE_APP_ENV=production

# TODO(backend): replace with the real production API origin before the first deploy.
VITE_API_BASE_URL=https://api.acse-solutions.com

VITE_ENCRYPTION_ENABLED=true

# TODO(backend): paste the production RSA public key (SPKI). The app refuses to
# boot while this is empty and VITE_ENCRYPTION_ENABLED is true — that is deliberate,
# it beats silently shipping plaintext. Full PEM or one-line base64 both work.
VITE_RSA_PUBLIC_KEY=

# ML assistant service origin. No dev proxy exists in a production build, so this
# must be a full origin the browser can reach, and that origin must send CORS
# headers for this site. TODO(backend): set the real ML origin before deploy.
VITE_ML_API_BASE_URL=https://octagon-overpass-smuggling.ngrok-free.dev
VITE_ML_DEV_PROXY_TARGET=
